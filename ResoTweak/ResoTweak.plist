<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
 <key>entry</key><dict>
  <key>label</key><string>ResoTweak</string>
  <key>cell</key><string>PSLinkCell</string>
  <key>isController</key><false/>
 </dict>
 <key>items</key><array>
  <dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Resolution (pixels)</string>
   <key>footerText</key><string>Set the width and height the game renders at. It is stretched to fill the screen. Choose your games below, then fully close and reopen them.</string></dict>
  <dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Enabled</string>
   <key>key</key><string>enabled</string><key>default</key><false/>
   <key>defaults</key><string>com.example.resotweak</string></dict>
  <dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Width</string>
   <key>key</key><string>width</string><key>default</key><string>1280</string>
   <key>keyboard</key><string>numbers</string><key>defaults</key><string>com.example.resotweak</string></dict>
  <dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Height</string>
   <key>key</key><string>height</string><key>default</key><string>720</string>
   <key>keyboard</key><string>numbers</string><key>defaults</key><string>com.example.resotweak</string></dict>
  <dict><key>cell</key><string>PSSwitchCell</string><key>label</key><string>Sharp pixels</string>
   <key>key</key><string>sharp</string><key>default</key><false/>
   <key>defaults</key><string>com.example.resotweak</string></dict>
  <dict><key>cell</key><string>PSGroupCell</string><key>label</key><string>Games</string>
   <key>footerText</key><string>Use the picker (needs AltList), or type bundle IDs separated by commas, e.g. com.supercell.clashofclans, com.mojang.minecraftpe</string></dict>
  <dict><key>cell</key><string>PSLinkListCell</string><key>label</key><string>Choose Apps</string>
   <key>detail</key><string>ATLApplicationListMultiSelectionController</string>
   <key>ALSettingsPath</key><string>/var/mobile/Library/Preferences/com.example.resotweak.plist</string>
   <key>ALSettingsKeyPrefix</key><string>app-</string>
   <key>ALAllowsSelection</key><true/>
   <key>ALSectionDescriptors</key><array>
    <dict><key>title</key><string>User Applications</string>
     <key>predicate</key><string>isSystemApplication = FALSE</string>
     <key>icon-size</key><integer>29</integer><key>suppress-hidden-apps</key><true/></dict>
   </array></dict>
  <dict><key>cell</key><string>PSEditTextCell</string><key>label</key><string>Bundle IDs</string>
   <key>key</key><string>bundleIDs</string><key>default</key><string></string>
   <key>defaults</key><string>com.example.resotweak</string></dict>
 </array>
 <key>title</key><string>ResoTweak</string>
</dict></plist>
